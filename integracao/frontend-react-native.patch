+import {
+  MensagemHistoricoAssistente,
+  OrientacaoTravessia,
+  RespostaAssistente,
+} from '../tipos/modelos';
+import { clienteApi } from './clienteApi';
+
+export async function perguntarAssistenteApi(
+  pergunta: string,
+  historico: MensagemHistoricoAssistente[] = [],
+  simplificar = false,
+): Promise<RespostaAssistente> {
+  const resposta = await clienteApi.post<RespostaAssistente>('/assistente/perguntas', {
+    pergunta: pergunta.trim(),
+    historico,
+    simplificar,
+  });
+  return resposta.data;
+}
+
+// Orientacao para quem vai atravessar, gerada com dicas da base para o clima e o periodo do dia.
+export async function obterOrientacaoApi(
+  condicaoClimatica: string,
+  segundosExtras: number,
+  periodo: 'dia' | 'noite',
+): Promise<OrientacaoTravessia> {
+  const resposta = await clienteApi.post<OrientacaoTravessia>('/assistente/orientacao', {
+    condicaoClimatica,
+    segundosExtras,
+    periodo,
+  });
+  return resposta.data;
+}

+import { StatusDispositivo } from '../tipos/modelos';
+
+export interface DescricaoStatus {
+  titulo: string;
+  confirmado: boolean;
+}
+
+const DESCRICOES: Record<StatusDispositivo, DescricaoStatus> = {
+  EXECUTADO: { titulo: 'Semáforo confirmou o tempo extra', confirmado: true },
+  ACEITO: { titulo: 'Semáforo aceitou; tempo extra será aplicado na próxima travessia', confirmado: true },
+  PENDENTE: { titulo: 'Aguardando resposta do semáforo', confirmado: false },
+  REJEITADO: { titulo: 'Semáforo recusou o pedido', confirmado: false },
+  SEM_CONFIRMACAO: { titulo: 'Semáforo não respondeu a tempo', confirmado: false },
+  FALHA_MQTT: { titulo: 'Falha de comunicação com o semáforo', confirmado: false },
+  DISPOSITIVO_OFFLINE: { titulo: 'Semáforo desconectado', confirmado: false },
+  DISPOSITIVO_REINICIADO: { titulo: 'Semáforo reiniciou e o pedido se perdeu', confirmado: false },
+  SEMAFORO_OCUPADO: { titulo: 'Já existe um pedido em andamento neste semáforo', confirmado: false },
+  FALHA_COMUNICACAO_IOT: { titulo: 'Serviço do semáforo indisponível', confirmado: false },
+};
+
+const MOTIVOS: Record<string, string> = {
+  EXTENSAO_JA_PROGRAMADA: 'esta travessia já recebeu tempo extra',
+  SEGUNDOS_FORA_DO_LIMITE: 'tempo extra fora do limite permitido',
+  ACAO_DESCONHECIDA: 'comando não reconhecido',
+};
+
+export function descreverStatusDispositivo(status?: StatusDispositivo | null): DescricaoStatus {
+  if (!status) {
+    return { titulo: 'Sem informação do semáforo', confirmado: false };
+  }
+  return DESCRICOES[status] ?? { titulo: status, confirmado: false };
+}
+
+export function traduzirDetalheDispositivo(detalhe?: string | null): string | null {
+  if (!detalhe) {
+    return null;
+  }
+  return MOTIVOS[detalhe] ?? detalhe;
+}

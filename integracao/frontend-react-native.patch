+        Animated.sequence([
+          Animated.delay(indice * 160),
+          Animated.timing(ponto, { toValue: 1, duration: 320, useNativeDriver: true }),
+          Animated.timing(ponto, { toValue: 0.3, duration: 320, useNativeDriver: true }),
+          Animated.delay((2 - indice) * 160),
+        ]),
+      ),
+    );
+    animacoes.forEach((animacao) => animacao.start());
+    return () => animacoes.forEach((animacao) => animacao.stop());
+  }, [pontos]);

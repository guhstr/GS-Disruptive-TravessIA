+import * as Speech from 'expo-speech';
+
+// Remove as marcacoes de fonte ([1], [1, 2]) para a leitura em voz alta ficar natural.
+export function textoParaLeitura(texto: string): string {
+  return texto.replace(/\s*\[\d+(?:\s*,\s*\d+)*\]/g, '').trim();
+}
+
+export function lerEmVoz(texto: string, aoTerminar?: () => void): void {
+  Speech.stop();
+  Speech.speak(textoParaLeitura(texto), {
+    language: 'pt-BR',
+    rate: 0.9,
+    onDone: aoTerminar,
+    onStopped: aoTerminar,
+    onError: aoTerminar,
+  });
+}
+
+export function pararLeitura(): void {
+  Speech.stop();
+}

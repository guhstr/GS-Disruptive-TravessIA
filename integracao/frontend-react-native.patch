+function nomeDocumento(arquivo: string): string {
+  const nome = arquivo.replace(/^\d+-/, '').replace(/\.md$/, '').replace(/-/g, ' ');
+  return nome.charAt(0).toUpperCase() + nome.slice(1);
+}
+
+function montarHistorico(mensagens: MensagemConversa[]): MensagemHistoricoAssistente[] {
+  return mensagens
+    .filter((mensagem) => !mensagem.erro)
+    .slice(-LIMITE_HISTORICO)
+    .map((mensagem) => ({ papel: mensagem.papel, texto: mensagem.texto.slice(0, 2000) }));
+}

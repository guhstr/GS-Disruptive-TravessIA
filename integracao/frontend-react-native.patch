+import { Ionicons } from '@expo/vector-icons';
+import React, { useState } from 'react';
+import { ActivityIndicator, StyleSheet, Text, TouchableOpacity, View } from 'react-native';
+import { estilosGlobais } from '../estilos/estilosGlobais';
+import { bordas, cores, espacamentos, fontes } from '../estilos/tema';
+import { extrairMensagemErro } from '../servicos/clienteApi';
+import { obterResumoIaApi } from '../servicos/servicoSolicitacao';
+import { ResumoSolicitacoesIa } from '../tipos/modelos';
+
+const PERIODOS = [7, 30, 90];
+
+// Resumo das solicitacoes para o gestor: indicadores agregados (sem dados pessoais) e
+// um texto com recomendacoes escrito pela IA.
+export const CartaoResumoIa: React.FC = () => {
+  const [dias, setDias] = useState<number>(30);
+  const [resumo, setResumo] = useState<ResumoSolicitacoesIa | null>(null);
+  const [carregando, setCarregando] = useState<boolean>(false);
+  const [erro, setErro] = useState<string | null>(null);
+
+  async function gerar(periodo: number) {
+    setDias(periodo);
+    setCarregando(true);
+    setErro(null);
+    try {
+      setResumo(await obterResumoIaApi(periodo));
+    } catch (falha) {
+      setErro(extrairMensagemErro(falha));
+    } finally {
+      setCarregando(false);
+    }
+  }
+
+  const indicadores = resumo?.indicadores;
+  const linhas = (resumo?.resumo ?? '').split('\n').map((l) => l.trim()).filter(Boolean);
+
+  return (
+    <View style={[estilosGlobais.cartao, estilos.cartao]}>
+      <View style={estilos.cabecalho}>
+        <Ionicons name="analytics-outline" size={20} color={cores.primaria} />
+        <Text style={estilos.titulo}>Resumo com IA para o gestor</Text>
+      </View>
+      <Text style={estilos.descricao}>
+        Indicadores do período e recomendações escritas pela IA. Nenhum dado pessoal é enviado.
+      </Text>
+
+      <View style={estilos.linhaPeriodos}>
+        {PERIODOS.map((periodo) => (
+          <TouchableOpacity
+            key={periodo}
+            style={[estilos.chipPeriodo, dias === periodo && resumo ? estilos.chipPeriodoAtivo : null]}
+            onPress={() => gerar(periodo)}
+            disabled={carregando}
+            accessibilityRole="button"
+            accessibilityLabel={`Gerar resumo dos últimos ${periodo} dias`}
+          >
+            <Text style={[estilos.textoPeriodo, dias === periodo && resumo ? estilos.textoPeriodoAtivo : null]}>
+              {periodo} dias
+            </Text>
+          </TouchableOpacity>
+        ))}
+      </View>
+
+      {carregando ? (
+        <View style={estilos.carregando}>
+          <ActivityIndicator color={cores.primaria} />
+          <Text style={estilos.descricao}>Analisando as solicitações...</Text>
+        </View>
+      ) : null}
+      {erro ? <Text style={estilos.erro}>{erro}</Text> : null}
+
+      {resumo && indicadores && !carregando ? (
+        <>
+          <View style={estilos.grade}>
+            <Indicador valor={String(indicadores.totalSolicitacoes)} rotulo="solicitações" />
+            <Indicador valor={`${indicadores.percentualComChuva}%`} rotulo="com chuva" />
+            <Indicador valor={`${indicadores.percentualConfirmadas}%`} rotulo="confirmadas" />
+          </View>
+          <View style={estilos.blocoTexto}>
+            {linhas.map((linha, indice) =>
+              linha.startsWith('- ') ? (
+                <View key={indice} style={estilos.linhaRecomendacao}>
+                  <Ionicons name="checkmark-circle-outline" size={16} color={cores.secundaria} />
+                  <Text style={estilos.textoRecomendacao}>{linha.slice(2)}</Text>
+                </View>
+              ) : (
+                <Text key={indice} style={estilos.textoResumo}>
+                  {linha}
+                </Text>
+              )
+            )}
+          </View>
+          <Text style={estilos.origem}>
+            {resumo.geradoPorIa
+              ? 'Texto gerado pela IA a partir dos indicadores acima.'
+              : 'IA indisponível: texto montado automaticamente a partir dos indicadores.'}
+          </Text>
+        </>
+      ) : null}
+    </View>
+  );
+};
+
+const Indicador: React.FC<{ valor: string; rotulo: string }> = ({ valor, rotulo }) => (
+  <View style={estilos.indicador}>
+    <Text style={estilos.valorIndicador}>{valor}</Text>
+    <Text style={estilos.rotuloIndicador}>{rotulo}</Text>
+  </View>
+);
+
+const estilos = StyleSheet.create({
+  cartao: {
+    borderColor: cores.primaria,
+  },
+  cabecalho: {
+    flexDirection: 'row',
+    alignItems: 'center',
+    gap: 8,
+  },
+  titulo: {
+    fontSize: fontes.tamanhos.subtitulo,
+    fontWeight: '800',
+    color: cores.textoPrincipal,
+  },
+  descricao: {
+    fontSize: fontes.tamanhos.pequeno,
+    color: cores.textoSecundario,
+    marginTop: 4,
+  },
+  linhaPeriodos: {
+    flexDirection: 'row',
+    gap: 8,
+    marginTop: espacamentos.sm,
+  },
+  chipPeriodo: {
+    borderWidth: 1,
+    borderColor: cores.primaria,
+    borderRadius: bordas.raioCircular,
+    paddingHorizontal: 14,
+    paddingVertical: 8,
+  },
+  chipPeriodoAtivo: {
+    backgroundColor: cores.primaria,
+  },
+  textoPeriodo: {
+    color: cores.primaria,
+    fontWeight: '700',
+    fontSize: fontes.tamanhos.pequeno,
+  },
+  textoPeriodoAtivo: {
+    color: cores.textoClaro,
+  },
+  carregando: {
+    flexDirection: 'row',
+    alignItems: 'center',
+    gap: 8,
+    marginTop: espacamentos.sm,
+  },
+  erro: {
+    color: cores.perigo,
+    marginTop: espacamentos.sm,
+    fontSize: fontes.tamanhos.pequeno,
+  },
+  grade: {
+    flexDirection: 'row',
+    gap: 8,
+    marginTop: espacamentos.md,
+  },
+  indicador: {
+    flex: 1,
+    backgroundColor: cores.primariaClara,
+    borderRadius: bordas.raioMedio,
+    paddingVertical: 10,
+    alignItems: 'center',
+  },
+  valorIndicador: {
+    fontSize: fontes.tamanhos.titulo,
+    fontWeight: '900',
+    color: cores.primaria,
+  },
+  rotuloIndicador: {
+    fontSize: 12,
+    color: cores.textoSecundario,
+  },
+  blocoTexto: {
+    marginTop: espacamentos.md,
+    gap: 8,
+  },
+  textoResumo: {
+    fontSize: fontes.tamanhos.corpo,
+    lineHeight: 23,
+    color: cores.textoPrincipal,
+  },
+  linhaRecomendacao: {
+    flexDirection: 'row',
+    gap: 8,
+    alignItems: 'flex-start',
+  },
+  textoRecomendacao: {
+    flex: 1,
+    fontSize: fontes.tamanhos.corpo,
+    lineHeight: 22,
+    color: cores.textoPrincipal,
+  },
+  origem: {
+    marginTop: espacamentos.sm,
+    fontSize: 12,
+    color: cores.textoSecundario,
+    fontStyle: 'italic',
+  },
+});

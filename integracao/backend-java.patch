+package br.com.travessia.trafego.servico;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+/** Regra do tempo extra pelos codigos de condicao do OpenWeatherMap: chuva +10 s, tempo seco +5 s. */
+class RegraTempoExtraTest {
+
+    private static int segundos(String descricao, Integer... codigos) {
+        return ServicoSolicitacaoTravessia.decidirSegundosExtras(
+                new ServicoSolicitacaoTravessia.ClimaAtual(descricao, List.of(codigos)));
+    }
+
+    @Test
+    void chuvaGaroaTempestadeENeveDaoDezSegundos() {
+        assertEquals(10, segundos("Trovoada com chuva fraca", 200));
+        assertEquals(10, segundos("Trovoadas", 211));
+        assertEquals(10, segundos("Garoa fraca", 300));
+        assertEquals(10, segundos("Chuva leve", 500));
+        assertEquals(10, segundos("Chuva forte", 502));
+        assertEquals(10, segundos("Neve", 601));
+    }
+
+    @Test
+    void tempoSecoDaCincoSegundos() {
+        assertEquals(5, segundos("Céu limpo", 800));

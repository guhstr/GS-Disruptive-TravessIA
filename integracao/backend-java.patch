diff --git a/traffic-service/src/main/java/br/com/travessia/trafego/servico/ClienteIaComFallback.java b/traffic-service/src/main/java/br/com/travessia/trafego/servico/ClienteIaComFallback.java
new file mode 100644
index 0000000..d7415a3
--- /dev/null
+++ b/traffic-service/src/main/java/br/com/travessia/trafego/servico/ClienteIaComFallback.java
@@ -0,0 +1,69 @@
+package br.com.travessia.trafego.servico;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.ai.chat.client.ChatClient;
+import org.springframework.ai.openai.OpenAiChatOptions;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.stereotype.Component;
+
+import java.util.Arrays;
+import java.util.List;
+import java.util.Locale;
+import java.util.Optional;
+
+/**
+ * Envia o prompt ao Gemini tentando os modelos configurados em ordem.
+ * Quando um modelo esgota a cota (429), nao existe (404) ou esta indisponivel (5xx),
+ * o proximo da lista e usado. Erros de chave (401/403) interrompem as tentativas.
+ */
+@Component
+public class ClienteIaComFallback {
+
+    private static final Logger log = LoggerFactory.getLogger(ClienteIaComFallback.class);
+
+    private final ChatClient chatClient;
+    private final List<String> modelos;
+
+    public ClienteIaComFallback(ChatClient.Builder chatClientBuilder,
+                                @Value("${ia.modelos}") String modelosConfigurados) {
+        this.chatClient = chatClientBuilder.build();
+        this.modelos = Arrays.stream(modelosConfigurados.split(","))
+                .map(String::trim)
+                .filter(m -> !m.isEmpty())
+                .toList();
+    }
+
+    public Optional<String> perguntar(String prompt) {
+        for (String modelo : modelos) {
+            try {
+                String resposta = chatClient.prompt(prompt)
+                        .options(OpenAiChatOptions.builder().model(modelo).build())
+                        .call()
+                        .content();
+                log.info("Resposta obtida com o modelo {}", modelo);
+                return Optional.ofNullable(resposta);
+            } catch (Exception e) {
+                String mensagem = String.valueOf(e.getMessage());
+                if (erroDeCredencial(mensagem)) {
+                    log.warn("Chave da IA recusada; nenhum outro modelo sera tentado: {}", resumir(mensagem));
+                    return Optional.empty();
+                }
+                log.warn("Modelo {} indisponivel ({}); tentando o proximo", modelo, resumir(mensagem));
+            }
+        }
+        log.warn("Nenhum dos {} modelos configurados respondeu", modelos.size());
+        return Optional.empty();
+    }
+
+    private static boolean erroDeCredencial(String mensagem) {
+        String texto = mensagem.toLowerCase(Locale.ROOT);
+        return texto.contains("401") || texto.contains("403")
+                || texto.contains("api key not valid") || texto.contains("api key must be set")
+                || texto.contains("permission_denied") || texto.contains("unauthenticated");
+    }
+
+    private static String resumir(String mensagem) {
+        return mensagem.length() > 160 ? mensagem.substring(0, 160) + "..." : mensagem;
+    }
+}

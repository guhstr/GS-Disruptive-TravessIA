+package br.com.travessia.gateway.controller;
+
+import br.com.travessia.gateway.feign.AssistenteClient;
+import io.swagger.v3.oas.annotations.Operation;
+import io.swagger.v3.oas.annotations.tags.Tag;
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.Max;
+import jakarta.validation.constraints.Min;
+import jakarta.validation.constraints.NotBlank;
+import jakarta.validation.constraints.NotNull;
+import jakarta.validation.constraints.Pattern;
+import jakarta.validation.constraints.Size;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+@RestController
+@RequestMapping("/api/assistente")
+@Tag(name = "Assistente de dúvidas", description = "Conversa com IA generativa e RAG sobre o projeto e a segurança na travessia")
+public class AssistenteController {
+
+    private final AssistenteClient assistenteClient;
+
+    public AssistenteController(AssistenteClient assistenteClient) {
+        this.assistenteClient = assistenteClient;
+    }
+
+    @PostMapping("/perguntas")
+    @Operation(summary = "Fazer uma pergunta ao assistente",
+            description = "Recupera trechos da base de conhecimento e gera a resposta com IA, considerando as "
+                    + "mensagens anteriores da conversa; informa quando não há dados suficientes.")
+    public ResponseEntity<Map<String, Object>> perguntar(@Valid @RequestBody PerguntaDto dto) {
+        Map<String, Object> corpo = new HashMap<>();
+        corpo.put("pergunta", dto.pergunta());
+        corpo.put("historico", dto.historico() == null ? List.of() : dto.historico());
+        corpo.put("simplificar", Boolean.TRUE.equals(dto.simplificar()));
+        return ResponseEntity.ok(assistenteClient.perguntar(corpo));
+    }
+
+    @PostMapping("/orientacao")
+    @Operation(summary = "Orientação para a travessia",
+            description = "Depois que o semáforo confirma o tempo extra, gera com IA uma orientação curta com dicas "
+                    + "de segurança da base de conhecimento para o clima e o período do dia. Sem IA, devolve um texto padrão.")
+    public ResponseEntity<Map<String, Object>> orientar(@Valid @RequestBody OrientacaoDto dto) {
+        Map<String, Object> corpo = new HashMap<>();
+        corpo.put("condicaoClimatica", dto.condicaoClimatica());
+        corpo.put("segundosExtras", dto.segundosExtras());
+        corpo.put("periodo", dto.periodo() == null ? "dia" : dto.periodo());
+        return ResponseEntity.ok(assistenteClient.orientar(corpo));
+    }
+
+    public record PerguntaDto(
+            @NotBlank(message = "Informe a pergunta")
+            @Size(min = 3, max = 500, message = "A pergunta deve ter entre 3 e 500 caracteres")
+            String pergunta,
+            @Size(max = 10, message = "O histórico pode ter no máximo 10 mensagens")
+            List<@Valid MensagemDto> historico,
+            Boolean simplificar) {
+    }
+
+    public record OrientacaoDto(
+            @NotBlank(message = "Informe a condição climática")
+            @Size(max = 100)
+            String condicaoClimatica,
+            @NotNull @Min(1) @Max(15)
+            Integer segundosExtras,
+            @Pattern(regexp = "dia|noite", message = "O período deve ser dia ou noite")
+            String periodo) {
+    }
+
+    public record MensagemDto(
+            @NotBlank
+            @Pattern(regexp = "usuario|assistente", message = "O papel deve ser usuario ou assistente")
+            String papel,
+            @NotBlank
+            @Size(max = 2000, message = "Cada mensagem pode ter no máximo 2000 caracteres")
+            String texto) {
+    }
+}

new file mode 100644
index 0000000..eb789a9
--- /dev/null
+++ b/traffic-service/src/main/java/br/com/travessia/trafego/servico/ServicoResumoIa.java
@@ -0,0 +1,148 @@
+package br.com.travessia.trafego.servico;
+
+import br.com.travessia.trafego.entidade.SolicitacaoTravessia;
+import br.com.travessia.trafego.repositorio.SolicitacaoTravessiaRepositorio;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.stereotype.Service;
+
+import java.time.LocalDateTime;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.function.Function;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import java.util.stream.Collectors;
+
+/**
+ * Resumo das solicitacoes para o gestor (ADMIN). Os indicadores sao calculados aqui, apenas com
+ * dados agregados (nenhum nome, idade ou localizacao de usuario), e o Gemini escreve o resumo e as
+ * recomendacoes. Se a IA falhar ou citar um numero que nao esta nos indicadores, o texto e montado
+ * sem IA a partir dos mesmos numeros.
+ */
+@Service
+public class ServicoResumoIa {
+
+    private static final Logger log = LoggerFactory.getLogger(ServicoResumoIa.class);
+    private static final Pattern NUMERO = Pattern.compile("\\d+");
+
+    private final SolicitacaoTravessiaRepositorio solicitacaoRepo;
+    private final ClienteIaComFallback clienteIa;
+
+    public ServicoResumoIa(SolicitacaoTravessiaRepositorio solicitacaoRepo, ClienteIaComFallback clienteIa) {
+        this.solicitacaoRepo = solicitacaoRepo;
+        this.clienteIa = clienteIa;
+    }
+
+    public Map<String, Object> gerarResumo(int dias) {
+        LocalDateTime inicio = LocalDateTime.now().minusDays(dias);
+        List<SolicitacaoTravessia> periodo = solicitacaoRepo.findAll().stream()
+                .filter(s -> s.getDataHoraSolicitacao() != null && s.getDataHoraSolicitacao().isAfter(inicio))
+                .toList();
+
+        long total = periodo.size();
+        long comChuva = periodo.stream().filter(s -> s.getSegundosExtras() == 10).count();
+        long confirmadas = periodo.stream()
+                .filter(s -> "EXECUTADO".equals(s.getStatusDispositivo()) || "ACEITO".equals(s.getStatusDispositivo()))
+                .count();
+        Map<String, Long> porSemaforo = contarOrdenado(periodo,
+                s -> s.getSemaforo() != null ? s.getSemaforo().getDescricao() : "Sem semáforo", 5);
+        Map<String, Long> porFaixaHorario = contarOrdenado(periodo, s -> faixaHorario(s.getDataHoraSolicitacao()), 4);
+        Map<String, Long> falhas = contarOrdenado(periodo.stream()
+                .filter(s -> s.getStatusDispositivo() != null
+                        && !"EXECUTADO".equals(s.getStatusDispositivo()) && !"ACEITO".equals(s.getStatusDispositivo()))
+                .toList(), SolicitacaoTravessia::getStatusDispositivo, 5);
+
+        Map<String, Object> indicadores = new LinkedHashMap<>();
+        indicadores.put("periodoDias", dias);
+        indicadores.put("totalSolicitacoes", total);
+        indicadores.put("solicitacoesComChuva", comChuva);
+        indicadores.put("percentualComChuva", percentual(comChuva, total));
+        indicadores.put("confirmadasPeloSemaforo", confirmadas);
+        indicadores.put("percentualConfirmadas", percentual(confirmadas, total));
+        indicadores.put("semaforosMaisUsados", porSemaforo);
+        indicadores.put("solicitacoesPorHorario", porFaixaHorario);
+        indicadores.put("falhasPorTipo", falhas);
+
+        Map<String, Object> resposta = new LinkedHashMap<>();
+        resposta.put("indicadores", indicadores);
+        if (total == 0) {
+            resposta.put("resumo", "Nenhuma solicitação de travessia nos últimos " + dias + " dias.");
+            resposta.put("geradoPorIa", false);
+            return resposta;
+        }
+
+        String textoIa = clienteIa.perguntar(montarPrompt(indicadores)).map(String::trim).orElse(null);
+        boolean valido = textoIa != null && !textoIa.isBlank() && textoIa.length() <= 2000
+                && numerosConferem(textoIa, indicadores);
+        if (textoIa != null && !valido) {
+            log.warn("Resumo da IA descartado (vazio, longo ou com numeros fora dos indicadores)");
+        }
+        resposta.put("resumo", valido ? textoIa : resumoSemIa(indicadores));
+        resposta.put("geradoPorIa", valido);
+        return resposta;
+    }
+
+    private String montarPrompt(Map<String, Object> indicadores) {
+        return "Você é analista de mobilidade urbana e escreve para o gestor do Travessia Inteligente, sistema que dá "
+                + "tempo extra de travessia a pessoas idosas e com deficiência (+5 s com tempo seco, +10 s com chuva). "
+                + "Com base SOMENTE nos indicadores abaixo, escreva em português do Brasil: um parágrafo de visão geral "
+                + "(até 3 frases) e depois exatamente 3 recomendações práticas para a prefeitura, uma por linha, cada "
+                + "uma começando com \"- \". Não invente números: use apenas os números dos indicadores. "
+                + "Não use markdown além do \"- \" das recomendações.\n\nINDICADORES:\n" + indicadores;
+    }
+
+    /** Todo numero citado no texto precisa existir nos indicadores (protecao contra numeros inventados). */
+    private boolean numerosConferem(String texto, Map<String, Object> indicadores) {
+        Set<String> permitidos = new HashSet<>(Set.of("5", "10", "15"));
+        Matcher noIndicador = NUMERO.matcher(indicadores.toString());
+        while (noIndicador.find()) {
+            permitidos.add(noIndicador.group());
+        }
+        Matcher noTexto = NUMERO.matcher(texto);
+        while (noTexto.find()) {
+            if (!permitidos.contains(noTexto.group())) {
+                log.warn("Numero {} citado pela IA nao esta nos indicadores", noTexto.group());
+                return false;
+            }
+        }
+        return true;
+    }
+
+    @SuppressWarnings("unchecked")
+    private String resumoSemIa(Map<String, Object> indicadores) {
+        Map<String, Long> semaforos = (Map<String, Long>) indicadores.get("semaforosMaisUsados");
+        String maisUsado = semaforos.isEmpty() ? "-" : semaforos.keySet().iterator().next();
+        return "Nos últimos " + indicadores.get("periodoDias") + " dias foram " + indicadores.get("totalSolicitacoes")
+                + " solicitações, " + indicadores.get("percentualComChuva") + "% com chuva e "
+                + indicadores.get("percentualConfirmadas") + "% confirmadas pelo semáforo. O semáforo mais usado foi "
+                + maisUsado + ".\n- Avaliar aumentar o tempo padrão de travessia nos semáforos mais usados."
+                + "\n- Verificar a conexão dos semáforos que tiveram falhas de confirmação."
+                + "\n- Divulgar o aplicativo perto dos cruzamentos com mais pedidos.";
+    }
+
+    private static Map<String, Long> contarOrdenado(List<SolicitacaoTravessia> lista,
+                                                    Function<SolicitacaoTravessia, String> chave, int limite) {
+        return lista.stream()
+                .collect(Collectors.groupingBy(chave, Collectors.counting()))
+                .entrySet().stream()
+                .sorted(Map.Entry.<String, Long>comparingByValue().reversed())
+                .limit(limite)
+                .collect(Collectors.toMap(Map.Entry::getKey, Map.Entry::getValue, (a, b) -> a, LinkedHashMap::new));
+    }
+
+    private static String faixaHorario(LocalDateTime dataHora) {
+        int hora = dataHora.getHour();
+        if (hora < 6) return "madrugada (0h-6h)";
+        if (hora < 12) return "manhã (6h-12h)";
+        if (hora < 18) return "tarde (12h-18h)";
+        return "noite (18h-24h)";
+    }
+
+    private static long percentual(long parte, long total) {
+        return total == 0 ? 0 : Math.round(100.0 * parte / total);
+    }
+}

+package br.com.travessia.trafego.servico;
+
+import br.com.travessia.trafego.cliente.ServicoIotCliente;
+import feign.FeignException;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.stereotype.Service;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * Solicita ao servico IoT a extensao do tempo de travessia no semaforo simulado (ESP32/Wokwi)
+ * e traduz a resposta em um status para a solicitacao. O status so e EXECUTADO quando o
+ * dispositivo confirma; publicar o comando nao basta.
+ */
+@Service
+public class ServicoComandoSemaforo {
+
+    private static final Logger log = LoggerFactory.getLogger(ServicoComandoSemaforo.class);
+
+    private final ServicoIotCliente servicoIot;
+
+    public ServicoComandoSemaforo(ServicoIotCliente servicoIot) {
+        this.servicoIot = servicoIot;
+    }
+
+    public ResultadoComando estenderTravessia(Long solicitacaoId, Long semaforoId, String semaforoNome,
+                                              int segundosExtras) {
+        Map<String, Object> pedido = new HashMap<>();
+        pedido.put("solicitacaoId", solicitacaoId);
+        pedido.put("semaforoId", semaforoId);
+        pedido.put("semaforoNome", semaforoNome);
+        pedido.put("segundosExtras", segundosExtras);
+        try {
+            Map<String, Object> resposta = servicoIot.solicitarExtensao(pedido);
+            String status = String.valueOf(resposta.getOrDefault("status", "SEM_CONFIRMACAO"));
+            Object motivo = resposta.get("motivo");
+            Object aplicados = resposta.get("segundosAplicados");
+            Integer restante = resposta.get("travessiaRestanteSegundos") instanceof Number numero
+                    ? numero.intValue() : null;
+            String detalhe = "EXECUTADO".equals(status) && aplicados != null
+                    ? "Semaforo confirmou +" + aplicados + "s de travessia"
+                    : motivo != null ? motivo.toString() : null;
+            log.info("Solicitacao {} -> dispositivo respondeu {} ({})", solicitacaoId, status, detalhe);
+            return new ResultadoComando(status, detalhe, restante);
+        } catch (FeignException.Conflict e) {
+            return new ResultadoComando("SEMAFORO_OCUPADO",
+                    "Ja existe um pedido em andamento para este semaforo", null);
+        } catch (FeignException e) {
+            log.warn("Falha ao acionar o servico IoT: {}", e.getMessage());
+            return new ResultadoComando("FALHA_COMUNICACAO_IOT",
+                    "Servico IoT indisponivel; o semaforo nao foi acionado", null);
+        }
+    }
+
+    public record ResultadoComando(String status, String detalhe, Integer travessiaRestanteSegundos) {
+    }
+}

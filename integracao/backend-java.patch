+@RequestMapping("/api/solicitacoes")
+public class ResumoIaController {
+
+    private final ServicoResumoIa servicoResumoIa;
+
+    public ResumoIaController(ServicoResumoIa servicoResumoIa) {
+        this.servicoResumoIa = servicoResumoIa;
+    }
+
+    @GetMapping("/resumo-ia")
+    public ResponseEntity<Map<String, Object>> gerarResumo(
+            @RequestParam(name = "dias", defaultValue = "30") int dias) {
+        if (dias < 1 || dias > 365) {
+            throw new IllegalArgumentException("O período deve ter entre 1 e 365 dias");
+        }
+        return ResponseEntity.ok(servicoResumoIa.gerarResumo(dias));
+    }
+}

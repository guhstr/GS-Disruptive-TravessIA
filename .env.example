# Copie este arquivo para .env e preencha os valores. Nunca versione o .env.

# Google Gemini (https://aistudio.google.com/apikey) - usado pelo assistente FAQ (RAG)
GEMINI_API_KEY=
# Modelos tentados em ordem; se um esgotar a cota ou falhar, o proximo e usado
GEMINI_MODELOS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-3.5-flash,gemini-flash-latest,gemini-3.6-flash,gemini-3.7-flash,gemini-3-flash-preview,gemini-3.1-flash-lite-preview,gemini-3.8-flash,gemini-pro-latest,gemini-3.1-pro-preview
GEMINI_MODELOS_EMBEDDING=gemini-embedding-2,gemini-embedding-001,gemini-embedding-2-preview

# Broker MQTT publico, acessivel pelo simulador Wokwi
MQTT_BROKER_URL=tcp://broker.hivemq.com:1883
MQTT_TOPICO_BASE=fiap/gs2026/travessia
MQTT_TIMEOUT_CONFIRMACAO_SEGUNDOS=10
MQTT_TIMEOUT_EXECUCAO_SEGUNDOS=40

# Assistente de duvidas (RAG)
RAG_LIMIAR_SIMILARIDADE=0.62
RAG_QUANTIDADE_TRECHOS=4
# vetorial (padrao, melhor resultado na avaliacao) ou hibrida (vetores + BM25)
RAG_MODO_BUSCA=vetorial
